---
import { content, whatsappHref } from "@/content/freshcan-content";
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
const { footer, nav, game, contact, brand } = content;
const year = new Date().getFullYear();
---

<footer class="footer" id="footer" data-theme="ink" data-footer>
  <canvas class="footer__game" data-game aria-hidden="true"></canvas>
  <p class="sr-only">{game.a11yNote}</p>

  <div class="footer__top">
    <div>
      <p class="label footer__brand">{brand.name} · {brand.handle}</p>
      <p class="footer__tagline">{footer.tagline}<br />{footer.sub}</p>
    </div>
    <nav aria-label="Footer">
      <ul class="footer__nav">
        {nav.items.map((i) => <li><a href={i.href} data-nav-link>{i.label}</a></li>)}
        <li><a href={whatsappHref(contact.whatsappGreeting)} target="_blank" rel="noopener">WhatsApp</a></li>
        <li><a href={contact.instagram} target="_blank" rel="noopener">Instagram</a></li>
      </ul>
    </nav>
  </div>

  <div class="footer__mark" aria-hidden="true">
    <div class="footer__intro" data-game-intro>
      <p class="footer__intro-title">{game.intro}</p>
      <p class="label">{game.hint}</p>
    </div>
    <Logo class="footer__logo" />
  </div>

  <div class="footer__bar">
    <p class="footer__pill">© {year} {brand.name} · {footer.madeIn}</p>
    <p class="footer__credit">{footer.credit}</p>
    <div class="footer__score" aria-hidden="true">
      <span class="footer__can"><i data-game-fill></i></span>
      <span><b data-game-score>000</b> {game.scoreLabel}</span>
      <button class="footer__restart" type="button" data-game-restart hidden>{game.restart}</button>
    </div>
    <a class="footer__top-link" href="#inicio" data-nav-link><Icon name="arrow-up" />{footer.backToTop}</a>
  </div>
  <p class="footer__win" data-game-win aria-hidden="true">{game.win}</p>
</footer>

<style>
  .footer {
    position: sticky;
    bottom: 0;
    z-index: 0;
    height: 100svh;
    min-height: 36rem;
    background: var(--ink);
    color: var(--paper);
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding: calc(var(--header-h) + 1.5rem) var(--gutter) 1.2rem;
    overflow: hidden;
    user-select: none;
  }
  .footer__game {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    touch-action: pan-y;
  }
  .footer__top,
  .footer__bar {
    position: relative;
    z-index: 3;
  }
  .footer__top {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
    pointer-events: none;
  }
  .footer__top a,
  .footer__bar a,
  .footer__bar button {
    pointer-events: auto;
  }
  .footer__brand {
    color: var(--lime);
    margin-bottom: 0.6rem;
  }
  .footer__tagline {
    font-size: var(--t-body);
    font-weight: 500;
  }
  .footer__nav {
    display: flex;
    gap: 0.3rem 1.4rem;
    flex-wrap: wrap;
    justify-content: flex-end;
    max-width: 34rem;
    font-size: var(--t-small);
  }
  .footer__nav a {
    display: inline-block;
    padding: 0.6rem 0;
    transition: color 0.3s var(--ease-out);
  }
  .footer__nav a:hover {
    color: var(--lime);
  }
  .footer__mark {
    position: relative;
    display: grid;
    place-items: center;
    z-index: 1;
  }
  .footer__mark :global(.footer__logo) {
    width: min(64vw, 62vh);
    height: auto;
    color: var(--paper);
  }
  .footer__intro {
    position: absolute;
    z-index: 2;
    top: 0;
    text-align: center;
    color: var(--lime);
    transition:
      opacity 0.5s var(--ease-out),
      transform 0.5s var(--ease-out);
  }
  .footer__intro.is-gone {
    opacity: 0;
    transform: translateY(-1rem);
  }
  .footer__intro-title {
    font-family: var(--f-display);
    font-variation-settings: "wdth" 75;
    font-weight: 800;
    font-size: clamp(2.2rem, 5vw, 4.6rem);
    text-transform: uppercase;
    line-height: 1;
  }
  .footer__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem 1.4rem;
    flex-wrap: wrap;
    font-size: var(--t-small);
    pointer-events: none;
  }
  .footer__pill {
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: var(--paper);
    color: var(--ink);
    font-weight: 600;
  }
  .footer__credit {
    color: var(--paper-70);
    flex: 1;
    min-width: 14rem;
  }
  .footer__score {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-variant-numeric: tabular-nums;
  }
  .footer__score b {
    font-family: var(--f-display);
    font-size: 1.5rem;
    color: var(--lime);
  }
  .footer__can {
    position: relative;
    width: 1.1rem;
    height: 1.9rem;
    border: 2px solid var(--paper);
    border-radius: 0.3rem;
    overflow: hidden;
  }
  .footer__can i {
    position: absolute;
    inset: auto 0 0;
    height: 100%;
    background: var(--milk);
    transform-origin: 50% 100%;
    transform: scaleY(var(--fill, 0));
    transition: transform 0.4s var(--ease-out);
  }
  .footer__restart {
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    border: 1.5px solid var(--paper);
  }
  .footer__top-link {
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
    min-height: 2.75rem;
  }
  .footer__top-link svg {
    width: 1rem;
    height: 1rem;
  }
  .footer__win {
    position: absolute;
    z-index: 4;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    font-family: var(--f-display);
    font-variation-settings: "wdth" 75;
    font-weight: 800;
    font-size: clamp(4rem, 14vw, 14rem);
    text-transform: uppercase;
    color: var(--ink);
    background: var(--lime);
    border: 4px solid var(--ink);
    box-shadow: 6px 8px 0 var(--paper);
    padding: 0 0.25em;
    border-radius: 0.15em;
    rotate: -5deg;
    scale: 0;
    transition: scale 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
    pointer-events: none;
  }
  .footer__win.is-on {
    scale: 1;
  }
  @media (max-width: 760px) {
    .footer__top {
      flex-direction: column;
      gap: 1rem;
    }
    .footer__nav {
      justify-content: flex-start;
    }
    .footer__credit {
      order: 5;
      min-width: 100%;
    }
  }
</style>
