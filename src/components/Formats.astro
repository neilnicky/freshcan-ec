---
import { content, orderMessage, whatsappHref } from "@/content/freshcan-content";
import Img from "./Img.astro";
import Icon from "./Icon.astro";
import LiquidEdge from "./LiquidEdge.astro";
const { formats } = content;
---

<section class="formats" id="formatos" data-theme="ink" data-dark aria-labelledby="formats-title">
  <header class="formats__head">
    <p class="label formats__eyebrow" data-reveal><span data-fade>{formats.eyebrow}</span></p>
    <h2 class="formats__title section-title" id="formats-title" data-reveal>
      <span class="line" style="--i:0"><span>{formats.title[0]}</span></span>
      <span class="formats__burst" aria-hidden="true">
        <svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round">
          {Array.from({ length: 12 }, (_, i) => <path d={`M50 8 L50 26`} transform={`rotate(${i * 30} 50 50)`} />)}
        </svg>
      </span>
      <span class="line" style="--i:1"><span>{formats.title[1]}</span></span>
    </h2>
    <p class="formats__intro body" data-reveal><span data-fade style="--i:2">{formats.intro}</span></p>
  </header>

  <div class="formats__grid" data-formats-grid>
    <canvas class="formats__canvas" data-formats-canvas aria-hidden="true"></canvas>
    {
      formats.items.map((f, i) => (
        <article class={`fcard fcard--${f.tone}`} data-format={f.id} data-reveal style={`--i:${i}`}>
          <div class="fcard__stage" data-can-slot data-height={f.heightScale} data-width={f.widthScale}>
            <span class="fcard__flood" aria-hidden="true" />
            <span class="fcard__size" aria-hidden="true">{f.ml}</span>
          </div>
          <div class="fcard__foot">
            <h3 class="fcard__ml">
              {f.ml} <small>ml</small>
            </h3>
            <p class="fcard__line">{f.line}</p>
            <button
              class="fcard__toggle"
              type="button"
              aria-expanded="false"
              aria-controls={`order-${f.id}`}
              aria-label={`${formats.orderTitle}: ${f.ml} ml`}
              data-order-toggle
            >
              <Icon name="plus" />
            </button>
          </div>
          <div class="fcard__pop" id={`order-${f.id}`} data-order-pop data-ml={f.ml} hidden>
            <p class="note">{formats.orderTitle}</p>
            <div class="qty" role="group" aria-label={formats.quantityLabel}>
              <button type="button" class="qty__btn" data-qty="-1" aria-label="−1">
                <Icon name="minus" />
              </button>
              <output class="qty__value" data-qty-value aria-live="polite">
                1
              </output>
              <button type="button" class="qty__btn" data-qty="1" aria-label="+1">
                <Icon name="plus" />
              </button>
            </div>
            <a class="pill pill--light" href={whatsappHref(orderMessage(f, 1))} target="_blank" rel="noopener" data-order-link>
              <Icon name="whatsapp" />
              {formats.orderCta}
            </a>
            <p class="fcard__note">{formats.orderNote}</p>
          </div>
        </article>
      ))
    }
  </div>

  <figure class="formats__photo" data-reveal>
    <div class="formats__photo-frame" data-fade>
      <Img item={formats.photo} widths={[600, 1000, 1500]} sizes="(max-width: 760px) 92vw, 60vw" />
    </div>
  </figure>
  <LiquidEdge position="bottom" slow />
</section>

<style>
  .formats {
    position: relative;
    z-index: 7;
    background: var(--ink);
    color: var(--paper);
    padding: clamp(3rem, 6vw, 6rem) var(--gutter) clamp(4rem, 8vw, 8rem);
  }
  .formats__head {
    text-align: center;
    display: grid;
    justify-items: center;
    gap: 1.2rem;
    margin-bottom: clamp(2.5rem, 5vw, 5rem);
  }
  .formats__eyebrow {
    color: var(--lime);
  }
  .formats__title {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.25em;
    flex-wrap: wrap;
  }
  .formats__burst {
    display: inline-block;
    width: 0.7em;
    color: var(--lime);
    animation: spin 12s linear infinite;
  }
  .formats__intro {
    max-width: 40ch;
    color: var(--paper-70);
  }
  .formats__grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(0.8rem, 1.6vw, 1.6rem);
    align-items: end;
  }
  .formats__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    pointer-events: none;
  }
  .fcard {
    position: relative;
    display: grid;
  }
  .fcard__stage {
    position: relative;
    aspect-ratio: 4 / 5;
    background: var(--mist);
    border-radius: var(--radius) var(--radius) 0 0;
    overflow: hidden;
    isolation: isolate;
  }
  .fcard__flood {
    position: absolute;
    left: var(--fx, 50%);
    top: var(--fy, 50%);
    width: 300%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--tone);
    transform: translate(-50%, -50%) scale(0);
    transition: transform 0.7s var(--ease-out);
    z-index: -1;
  }
  .fcard.is-hover .fcard__flood {
    transform: translate(-50%, -50%) scale(1);
  }
  .fcard--steel {
    --tone: var(--steel);
  }
  .fcard--husk {
    --tone: var(--husk);
  }
  .fcard--palm {
    --tone: var(--palm);
  }
  .fcard__size {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    font-family: var(--f-display);
    font-variation-settings: "wdth" 75;
    font-weight: 800;
    font-size: clamp(6rem, 15vw, 15rem);
    color: rgb(17 18 16 / 0.07);
    line-height: 1;
    z-index: 0;
  }
  .fcard__foot {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.2rem 1rem;
    align-items: center;
    padding: 1rem 1.2rem 1.2rem;
    background: var(--paper);
    color: var(--ink);
    border-radius: 0 0 var(--radius) var(--radius);
  }
  .fcard__ml {
    font-family: var(--f-display);
    font-variation-settings: "wdth" 75;
    font-weight: 800;
    font-size: clamp(1.8rem, 2.6vw, 2.6rem);
    line-height: 1;
    text-transform: uppercase;
  }
  .fcard__ml small {
    font-size: 0.5em;
  }
  .fcard__line {
    grid-column: 1;
    font-size: var(--t-small);
    color: var(--ink-60);
  }
  .fcard__toggle {
    grid-column: 2;
    grid-row: 1 / 3;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    border: 2px solid var(--ink);
    transition:
      background 0.3s var(--ease-out),
      transform 0.45s var(--ease-out);
  }
  .fcard__toggle svg {
    width: 1.2rem;
    height: 1.2rem;
  }
  .fcard__toggle:hover {
    background: var(--lime);
  }
  .fcard__toggle[aria-expanded="true"] {
    transform: rotate(45deg);
    background: var(--ink);
    color: var(--paper);
  }
  .fcard__pop {
    position: absolute;
    z-index: 4;
    right: 0.8rem;
    bottom: 6.2rem;
    width: min(18rem, calc(100% - 1.6rem));
    padding: 1.1rem;
    display: grid;
    gap: 0.9rem;
    border-radius: 1rem;
    background: var(--ink);
    color: var(--paper);
    border: 1.5px solid rgb(244 246 245 / 0.18);
    box-shadow: 0 1.2rem 2.5rem -1rem rgb(0 0 0 / 0.5);
    transform-origin: 90% 100%;
    animation: pop 0.28s var(--ease-out);
  }
  .fcard__pop[hidden] {
    display: none;
  }
  .fcard__pop .note {
    color: var(--lime);
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(0.6rem) scale(0.96);
    }
  }
  .qty {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border: 1.5px solid rgb(244 246 245 / 0.25);
    border-radius: 999px;
    padding: 0.25rem;
  }
  .qty__btn {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
  }
  .qty__btn:hover {
    background: rgb(244 246 245 / 0.12);
  }
  .qty__btn svg {
    width: 1rem;
    height: 1rem;
  }
  .qty__value {
    font-family: var(--f-display);
    font-weight: 800;
    font-size: 1.5rem;
    font-variant-numeric: tabular-nums;
  }
  .fcard__note {
    font-size: 0.8rem;
    color: var(--paper-70);
  }
  .formats__photo {
    margin: clamp(3rem, 6vw, 6rem) auto 0;
    width: min(100%, 64rem);
  }
  .formats__photo-frame {
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
  }

  @media (max-width: 860px) {
    .formats__grid {
      grid-template-columns: 1fr;
    }
    .fcard__stage {
      aspect-ratio: 5 / 4;
    }
  }
</style>
