---
import { content } from "@/content/freshcan-content";
import Img from "./Img.astro";
import Icon from "./Icon.astro";
const { hero, brand } = content;
const fallback = {
  key: "can-moments" as const,
  alt: hero.canAlt,
  focus: "50% 45%",
  source: "https://www.instagram.com/freshcan.ec/p/DeM54mAljui/",
};
---

<section class="hero" id="inicio" data-hero data-theme="paper" aria-labelledby="hero-title">
  <div class="hero__studio" aria-hidden="true"></div>

  <h1 class="hero__title display" id="hero-title" data-hero-title>
    <span class="line hero__l1" style="--i:0"><span>{hero.titleTop}</span></span>
    <span class="line hero__l2" style="--i:1"><span>{hero.titleBottom}</span></span>
  </h1>

  <!-- 3D can is drawn on the fixed protagonist canvas; this is the no-WebGL fallback -->
  <div class="hero__fallback" data-can-fallback>
    <Img item={fallback} widths={[480, 800, 1100]} sizes="(max-width: 760px) 70vw, 30vw" eager />
  </div>
  <div class="hero__can-anchor" data-can-anchor aria-hidden="true"></div>

  <div class="hero__sticker" aria-hidden="true" data-fade style="--i:3">
    <svg viewBox="0 0 200 200" class="hero__ring">
      <defs><path id="hero-ring" d="M100 100 m-78 0 a78 78 0 1 1 156 0 a78 78 0 1 1 -156 0"></path></defs>
      <text><textPath href="#hero-ring" textLength="486" lengthAdjust="spacing">{hero.sticker}</textPath></text>
    </svg>
    <span class="hero__coco">🥥</span>
  </div>

  <ul class="hero__bullets label" data-fade style="--i:2">
    {hero.bullets.map((b) => <li>{b}</li>)}
  </ul>

  <div class="hero__aside" data-fade style="--i:4">
    <p class="body">{hero.body}</p>
    <a class="pill" href={hero.cta.href} data-nav-link>{hero.cta.label}<Icon name="arrow-right" /></a>
  </div>

  <p class="hero__handle label" data-fade style="--i:5">{brand.handle} · {brand.country}</p>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    padding: calc(var(--header-h) + 3vh) var(--gutter) 2rem;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-template-rows: auto 1fr auto auto;
    overflow: clip;
  }
  .hero__studio {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(42vw 52vh at 50% 58%, #ffffff 0%, rgb(255 255 255 / 0) 70%),
      linear-gradient(180deg, var(--paper) 0%, var(--mist) 100%);
    z-index: 0;
  }
  .hero__title {
    position: relative;
    z-index: 6;
    grid-column: 1 / -1;
    grid-row: 1 / 3;
    display: grid;
    align-content: space-between;
    pointer-events: none;
  }
  .hero__l2 {
    justify-self: end;
    text-align: right;
  }
  .hero__can-anchor {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 1px;
    height: 1px;
  }
  .hero__fallback {
    display: none;
    position: absolute;
    left: 50%;
    top: 52%;
    width: min(30vw, 46vh);
    aspect-ratio: 4 / 5;
    transform: translate(-50%, -50%) rotate(-4deg);
    border-radius: var(--radius);
    overflow: hidden;
    z-index: 2;
    box-shadow: 0 2rem 4rem -2rem rgb(17 18 16 / 0.35);
  }
  :global(html.no-webgl) .hero__fallback,
  :global(html:not(.js)) .hero__fallback {
    display: block;
  }
  .hero__sticker {
    position: absolute;
    z-index: 6;
    left: 60%;
    top: 22%;
    width: clamp(7rem, 11vw, 10.5rem);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--lime);
    border: 2.5px solid var(--ink);
    box-shadow: 3px 4px 0 var(--ink);
  }
  .hero__ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    animation: spin 16s linear infinite;
  }
  .hero__ring text {
    font-family: var(--f-display);
    font-variation-settings: "wdth" 75;
    font-weight: 800;
    font-size: 15.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    fill: var(--ink);
  }
  .hero__coco {
    font-size: clamp(1.6rem, 2.4vw, 2.2rem);
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  .hero__bullets {
    position: relative;
    z-index: 6;
    grid-column: 9 / -1;
    grid-row: 1;
    align-self: start;
    justify-self: end;
    display: flex;
    gap: 1.4rem;
    margin-top: 0.6rem;
  }
  .hero__bullets li::before {
    content: "";
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    margin-right: 0.45rem;
    border-radius: 50%;
    background: var(--ink);
    vertical-align: 0.1em;
  }
  .hero__aside {
    position: relative;
    z-index: 6;
    grid-column: 9 / -1;
    grid-row: 3;
    justify-self: end;
    display: grid;
    gap: 1.2rem;
    justify-items: start;
    margin-top: 1.5rem;
  }
  .hero__handle {
    position: relative;
    z-index: 6;
    grid-column: 1 / 6;
    grid-row: 3;
    align-self: end;
    color: var(--ink-60);
  }

  @media (max-width: 760px) {
    .hero {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto 1fr auto;
      text-align: center;
      padding-bottom: 1.5rem;
    }
    .hero__title {
      grid-row: 1;
      text-align: center;
      align-content: start;
    }
    .hero__l2 {
      justify-self: center;
      text-align: center;
    }
    .hero__bullets {
      grid-column: 1;
      grid-row: 2;
      justify-self: center;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.3rem 1rem;
      margin-top: 1rem;
      font-size: 0.7rem;
    }
    .hero__bullets li {
      white-space: nowrap;
    }
    .hero__sticker {
      left: auto;
      right: 6%;
      top: 44%;
      width: 6.2rem;
    }
    .hero__ring text {
      font-size: 17px;
    }
    .hero__aside {
      grid-column: 1;
      grid-row: 4;
      justify-self: center;
      justify-items: center;
    }
    .hero__aside .body {
      margin-inline: auto;
    }
    .hero__handle {
      display: none;
    }
    .hero__fallback {
      width: 62vw;
      top: 50%;
    }
  }
</style>
