---
type Name = "arrow-right" | "arrow-left" | "plus" | "whatsapp" | "instagram" | "pin" | "arrow-up" | "minus";
interface Props {
  name: Name;
}
const { name } = Astro.props;
---

<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === "arrow-right" && <path d="M4 12h15M13 6l6 6-6 6" />}
  {name === "arrow-left" && <path d="M20 12H5M11 6l-6 6 6 6" />}
  {name === "arrow-up" && <path d="M12 20V5M6 11l6-6 6 6" />}
  {name === "plus" && <path d="M12 4v16M4 12h16" />}
  {name === "minus" && <path d="M4 12h16" />}
  {name === "pin" && <><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z" /><circle cx="12" cy="9.5" r="2.5" /></>}
  {name === "instagram" && <><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" /></>}
  {
    name === "whatsapp" && (
      <path d="M20.5 11.8a8.5 8.5 0 0 1-12.6 7.4L3.5 20.5l1.4-4.2A8.5 8.5 0 1 1 20.5 11.8Zm-11.6-4c.3-.6.6-.6.9-.6h.6c.2 0 .4 0 .6.5l.8 1.9c.1.2.1.4 0 .6l-.5.7c-.1.2-.2.3 0 .6.5.8 1.1 1.5 1.8 2 .6.4 1 .6 1.3.7.2.1.4 0 .5-.1l.7-.8c.2-.2.3-.2.5-.1l1.9.9c.2.1.4.2.4.3 0 .5-.2 1.2-.6 1.5-.5.4-1.2.7-2 .6-1.1-.1-2.7-.7-4.2-2.1-1.4-1.3-2.3-2.8-2.5-3.8-.2-.9 0-1.8.8-2.8Z" />
    )
  }
</svg>
