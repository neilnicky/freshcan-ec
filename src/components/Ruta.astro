---
import { content, orderMessage, whatsappHref } from "@/content/freshcan-content";
import Icon from "./Icon.astro";
import LiquidEdge from "./LiquidEdge.astro";
const { ruta, formats, contact } = content;
const first = formats.items[1]!;
---

<section class="ruta" id="ruta-fresh" data-theme="paper" aria-labelledby="ruta-title">
  <div class="ruta__grid">
    <div class="box box--lime" data-reveal>
      <span class="rivets" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
      <p class="label" data-fade>{ruta.eyebrow}</p>
      <h2 class="ruta__title section-title" id="ruta-title">
        {
          ruta.title.map((l, i) => (
            <span class="line" style={`--i:${i}`}>
              <span>{l}</span>
            </span>
          ))
        }
      </h2>
      <p class="body" data-fade style="--i:2">{ruta.body}</p>

      <div class="retailer" data-fade style="--i:3">
        <span class="sticker" style="--rot:-4deg">{ruta.retailerLabel}</span>
        <div>
          <h3 class="retailer__name">{ruta.retailer.name}</h3>
          <p class="retailer__addr">{ruta.retailer.address}</p>
        </div>
        <div class="retailer__links">
          <a href={ruta.retailer.mapsHref} target="_blank" rel="noopener"><Icon name="pin" />Google Maps</a>
          <a href={ruta.retailer.instagram} target="_blank" rel="noopener"><Icon name="instagram" />Instagram</a>
        </div>
      </div>

      <div class="spots" data-fade style="--i:4">
        <p class="label">{ruta.spotsLabel}</p>
        <ul>{ruta.spots.map((s) => <li>{s.name}</li>)}</ul>
        <p class="spots__note note">{ruta.spotsNote}</p>
      </div>

      <div class="ruta__ctas" data-fade style="--i:5">
        <a class="pill" href={whatsappHref(contact.whatsappGreeting)} target="_blank" rel="noopener"><Icon name="whatsapp" />{ruta.ctaPrimary}</a>
        <a class="pill pill--ghost" href={ruta.ctaSecondary.href} target="_blank" rel="noopener">{ruta.ctaSecondary.label}</a>
      </div>
    </div>

    <div class="box box--ink" data-carousel data-reveal aria-roledescription="carousel" aria-label={ruta.carouselLabel}>
      <span class="rivets" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
      <span class="carousel__wipe" data-carousel-wipe aria-hidden="true"></span>
      <p class="label carousel__label">{ruta.carouselLabel}</p>
      <div class="carousel__stage" data-carousel-stage>
        <canvas data-carousel-canvas aria-hidden="true"></canvas>
      </div>
      <div class="carousel__controls">
        <button class="round-btn round-btn--light" type="button" data-carousel-prev aria-label={content.moments.prev}><Icon name="arrow-left" /></button>
        <p class="carousel__ml" aria-live="polite"><span data-carousel-ml>{first.ml}</span> <small>ml</small></p>
        <button class="round-btn round-btn--light" type="button" data-carousel-next aria-label={content.moments.next}><Icon name="arrow-right" /></button>
      </div>
      <a class="pill pill--light carousel__order" href={whatsappHref(orderMessage(first, 1))} target="_blank" rel="noopener" data-carousel-order>
        <Icon name="whatsapp" />{formats.orderCta}
      </a>
      <script type="application/json" data-carousel-data set:html={JSON.stringify(formats.items.map((f) => ({ ...f, href: whatsappHref(orderMessage(f, 1)) })))} />
    </div>
  </div>
  <LiquidEdge position="bottom" color="var(--paper)" />
</section>

<style>
  .ruta {
    position: relative;
    z-index: 2;
    background: var(--paper);
    padding: clamp(3rem, 6vw, 6rem) var(--gutter) clamp(4rem, 7vw, 7rem);
  }
  .ruta__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(0.8rem, 1.4vw, 1.4rem);
  }
  .box {
    position: relative;
    border: 2.5px solid var(--ink);
    border-radius: calc(var(--radius) * 1.3);
    padding: clamp(2rem, 3.4vw, 3.4rem);
    overflow: hidden;
    min-height: min(52rem, 92vh);
  }
  .box--lime {
    background: var(--lime);
    display: grid;
    align-content: start;
    gap: 1.4rem;
  }
  .box--ink {
    background: var(--ink);
    color: var(--paper);
    display: grid;
    grid-template-rows: auto 1fr auto auto;
    justify-items: center;
    gap: 1rem;
    isolation: isolate;
  }
  .rivets {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .rivets i {
    position: absolute;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: currentColor;
  }
  .rivets i:nth-child(1) {
    left: 1rem;
    top: 1rem;
  }
  .rivets i:nth-child(2) {
    right: 1rem;
    top: 1rem;
  }
  .rivets i:nth-child(3) {
    left: 1rem;
    bottom: 1rem;
  }
  .rivets i:nth-child(4) {
    right: 1rem;
    bottom: 1rem;
  }
  .ruta__title {
    font-size: clamp(2.6rem, 6vw, 6.8rem);
  }
  .retailer {
    display: grid;
    gap: 0.8rem;
    justify-items: start;
    padding: 1.2rem;
    border: 2px solid var(--ink);
    border-radius: 1rem;
    background: var(--paper);
  }
  .retailer__name {
    font-family: var(--f-display);
    font-variation-settings: "wdth" 75;
    font-weight: 800;
    font-size: clamp(1.6rem, 2.4vw, 2.4rem);
    line-height: 1;
    text-transform: uppercase;
  }
  .retailer__addr {
    font-size: var(--t-small);
  }
  .retailer__links {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
    font-size: var(--t-small);
    font-weight: 600;
  }
  .retailer__links a {
    display: inline-flex;
    gap: 0.35rem;
    align-items: center;
    min-height: 2.75rem;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .retailer__links svg {
    width: 1.05rem;
    height: 1.05rem;
  }
  .spots ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.6rem;
  }
  .spots li {
    padding: 0.3rem 0.7rem;
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    font-size: var(--t-small);
    font-weight: 600;
  }
  .spots__note {
    margin-top: 0.5rem;
    font-size: var(--t-small);
  }
  .ruta__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: auto;
  }
  .carousel__wipe {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 220%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--tone, var(--ink));
    transform: translate(-50%, -50%) scale(var(--s, 1));
    z-index: -1;
  }
  .carousel__label {
    color: var(--lime);
  }
  .carousel__stage {
    position: relative;
    width: 100%;
    min-height: 24rem;
  }
  .carousel__stage canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .carousel__controls {
    display: flex;
    align-items: center;
    gap: 1.4rem;
  }
  .round-btn--light {
    background: var(--paper);
    color: var(--ink);
  }
  .carousel__ml {
    min-width: 6ch;
    text-align: center;
    font-family: var(--f-display);
    font-variation-settings: "wdth" 75;
    font-weight: 800;
    font-size: clamp(2.4rem, 4vw, 4rem);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .carousel__ml small {
    font-size: 0.45em;
  }
  /* Light tones take ink text; palm keeps paper text */
  .box--ink[data-tone="steel"],
  .box--ink[data-tone="husk"] {
    color: var(--ink);
  }
  .box--ink[data-tone="steel"] .carousel__label,
  .box--ink[data-tone="husk"] .carousel__label {
    color: var(--ink);
  }
  @media (max-width: 960px) {
    .ruta__grid {
      grid-template-columns: 1fr;
    }
    .box {
      min-height: 0;
    }
    .box--ink {
      min-height: 40rem;
    }
  }
</style>
